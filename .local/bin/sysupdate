#!/bin/bash
# sysupdate -> weekly maintenance: dnf (snapshotted by snapper), flatpak, firmware,
#              then check the Hyprland config against the newly installed version.
# sysupdate --no-firmware  -> skip fwupd
set -uo pipefail

HYPR_CONF="$HOME/.config/hypr/hyprland.conf"
bold() { printf '\n\e[1;34m==> %s\e[0m\n' "$*"; }
warn() { printf '\e[1;33m!!  %s\e[0m\n' "$*"; }

hypr_ver() { rpm -q --qf '%{VERSION}' hyprland 2>/dev/null; }
before=$(hypr_ver)
last_snap=$(snapper -c root list --columns number 2>/dev/null | tail -1 | tr -dc '0-9')

bold "System packages (dnf)"
sudo dnf upgrade --refresh || warn "dnf upgrade failed"

bold "Flatpaks"
flatpak update -y
flatpak uninstall --unused -y

if [[ "${1:-}" != "--no-firmware" ]]; then
    bold "Firmware (fwupd)"
    fwupdmgr refresh --force >/dev/null 2>&1
    fwupdmgr update -y --no-reboot-check || true
fi

bold "Hyprland"
after=$(hypr_ver)
if [[ "$before" != "$after" ]]; then
    warn "Hyprland updated: $before -> $after"
    echo "    Release notes: https://github.com/hyprwm/Hyprland/releases/tag/v$after"
else
    echo "Hyprland unchanged ($after)"
fi
# Checks the config with the installed binary, not the running one
if Hyprland --verify-config -c "$HYPR_CONF" 2>&1 | grep -q 'config ok'; then
    echo "Config OK"
else
    warn "Config has errors for Hyprland $after:"
    Hyprland --verify-config -c "$HYPR_CONF" 2>&1 | grep -v '^=*$' | sed 's/^/    /'
fi

bold "Snapshots"
new_snaps=$(snapper -c root list --columns number,type,description 2>/dev/null \
    | awk -F'│' -v n="${last_snap:-0}" 'NR>2 && $1+0 > n')
if [[ -n "$new_snaps" ]]; then
    echo "$new_snaps"
    echo "    Undo a transaction: sudo snapper undochange <pre>..<post>"
else
    echo "No new snapshots (nothing installed?)"
fi

bold "Reboot"
if dnf needs-restarting -r >/dev/null 2>&1; then
    echo "No reboot needed"
else
    warn "Reboot recommended (kernel or core libraries updated)"
fi
