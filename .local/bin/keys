#!/usr/bin/python3 -I
# Shortcut cheatsheet: Hyprland binds plus French AltGr characters.
# Type to filter, arrows/PgUp/PgDn to scroll, Esc clears the filter or closes.
#   keys        open the cheatsheet in a floating foot window
#   keys --tui  run it in the current terminal
import curses
import os
import sys

# Hyprland binds come live from `hyprctl binds -j`: every bind in hyprland.lua
# with a description "Section|What it does[|key label]" is listed, in config
# order. Only things that aren't binds (gestures, AltGr characters) live here.
EXTRA = {
    "Workspaces": [
        ("3-finger swipe ↔", "Scroll columns"),
        ("3-finger swipe ↕", "Switch workspace"),
    ],
    "French (AltGr = Right Alt)": [
        ("AltGr + e", "é   (+ Shift: É)"),
        ("AltGr + `, then letter", "è à ù"),
        ("AltGr + 6, then letter", "ê â î ô û"),
        ("AltGr + Shift + ', then letter", "ë ï ü"),
        ("AltGr + ,", "ç   (+ Shift: Ç)"),
        ("AltGr + k", "œ   (+ Shift: Œ)"),
        ("AltGr + z", "æ   (+ Shift: Æ)"),
        ("AltGr + [  /  ]", "«  »"),
        ("Shift on the letter", "Capitals after dead keys (Ê, È…)"),
    ],
}

# hyprctl modmask bits, in display order
MODS = [(64, "Super"), (4, "Ctrl"), (8, "Alt"), (1, "Shift")]
KEY_NAMES = {
    "RETURN": "Return", "SPACE": "Space", "ESCAPE": "Escape", "TAB": "Tab",
    "SLASH": "/", "BRACKETLEFT": "[", "BRACKETRIGHT": "]", "COMMA": ",",
    "PERIOD": ".", "MINUS": "-", "EQUAL": "=", "PRINT": "Print",
    "HOME": "Home", "END": "End", "LEFT": "Left", "RIGHT": "Right",
    "UP": "Up", "DOWN": "Down",
}


def key_label(bind):
    k = bind["key"]
    name = KEY_NAMES.get(k.upper(), k.upper() if len(k) == 1 else k)
    return " + ".join([m for bit, m in MODS if bind["modmask"] & bit] + [name])


def load_shortcuts():
    import json
    import subprocess
    sections = {}
    try:
        out = subprocess.run(["hyprctl", "binds", "-j"], capture_output=True,
                             text=True, timeout=3).stdout
        binds = json.loads(out)
    except Exception:
        binds = []
        sections["Hyprland"] = [("(not running)", "hyprctl binds unavailable")]
    for b in binds:
        if not b.get("has_description"):
            continue
        section, _, rest = b["description"].partition("|")
        desc, _, label = rest.partition("|")
        sections.setdefault(section, []).append((label or key_label(b), desc))
    for section, items in EXTRA.items():
        sections.setdefault(section, []).extend(items)
    return sections


SHORTCUTS = {}


def build_rows(query):
    q = query.lower()
    rows = []
    for section, items in SHORTCUTS.items():
        hits = [i for i in items
                if not q or q in f"{section} {i[0]} {i[1]}".lower()]
        if hits:
            if rows:
                rows.append(("blank", "", ""))
            rows.append(("section", section, ""))
            rows.extend(("item", k, d) for k, d in hits)
    return rows


def main(scr):
    SHORTCUTS.update(load_shortcuts())
    curses.curs_set(0)
    curses.use_default_colors()
    # Monochrome to match foot/waybar/fuzzel: #2c2c2c text, #565656 and #8a8a8a grays
    rich = curses.COLORS >= 256
    curses.init_pair(1, 240 if rich else -1, -1)
    curses.init_pair(2, 245 if rich else -1, -1)
    section = curses.A_REVERSE | curses.A_BOLD
    key = curses.A_BOLD
    desc = curses.color_pair(1)
    dim = curses.color_pair(2) if rich else curses.A_DIM
    keyw = max(len(k) for items in SHORTCUTS.values() for k, _ in items) + 3
    query, top = "", 0

    while True:
        rows = build_rows(query)
        h, w = scr.getmaxyx()
        view = max(h - 3, 1)
        top = max(0, min(top, len(rows) - view))

        scr.erase()
        scr.addnstr(0, 1, "Search: ", w - 2, curses.A_BOLD)
        scr.addnstr(0, 9, query + "▏", max(w - 10, 0))
        for y, (kind, a, b) in enumerate(rows[top:top + view], start=2):
            if kind == "section":
                scr.addnstr(y, 1, f" {a} ", w - 2, section)
            elif kind == "item":
                scr.addnstr(y, 3, a, w - 4, key)
                if 3 + keyw < w:
                    scr.addnstr(y, 3 + keyw, b, w - 4 - keyw, desc)
        if not rows:
            scr.addnstr(2, 3, "No matches", w - 4, dim)
        hint = "type to filter · ↑↓ PgUp PgDn scroll · Esc clear/close"
        scr.addnstr(h - 1, 1, hint, w - 2, dim)
        scr.refresh()

        ch = scr.get_wch()
        if ch == "\x1b":
            if not query:
                return
            query, top = "", 0
        elif ch in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            query, top = query[:-1], 0
        elif ch == curses.KEY_UP:
            top -= 1
        elif ch == curses.KEY_DOWN:
            top += 1
        elif ch == curses.KEY_PPAGE:
            top -= view
        elif ch == curses.KEY_NPAGE:
            top += view
        elif isinstance(ch, str) and ch.isprintable():
            query, top = query + ch, 0


if __name__ == "__main__":
    if sys.argv[1:] == ["--tui"]:
        os.environ.setdefault("ESCDELAY", "25")
        try:
            curses.wrapper(main)
        except KeyboardInterrupt:
            pass
    else:
        os.execvp("foot", ["foot", "--app-id", "keys", "--title", "shortcuts",
                           os.path.abspath(sys.argv[0]), "--tui"])
