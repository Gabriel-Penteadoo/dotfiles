#!/bin/bash
# Machine docs picker via fuzzel (SUPER+D): this setup's own documentation.
# Entries are "label|target"; .md files open read-only in a floating foot popup
# (minimal nvim + LazyVim's render-markdown.nvim so headings/tables/lists are
# rendered; arrows/PgUp/PgDn scroll, / searches, Esc or q closes), "keys" opens the
# SUPER+/ cheatsheet, anything else uses the default app. Add a line to DOCS to list another doc.
DOCS=(
    "My machine — everyday use, upkeep, fixing things|$HOME/.claude/skills/setup/README.md"
    "Setup reference — every component, file and gotcha|$HOME/.claude/skills/setup/reference.md"
    "Keybinds cheatsheet|keys"
    "Omawrite README (built from source)|$HOME/src/omawrite/README.md"
)

choice=$(printf '%s\n' "${DOCS[@]%%|*}" \
    | fuzzel --dmenu --prompt "docs  ›  " --width 50 --lines ${#DOCS[@]}) || exit
for d in "${DOCS[@]}"; do
    [ "${d%%|*}" = "$choice" ] || continue
    target=${d#*|}
    case "$target" in
        keys) exec ~/.local/bin/keys ;;
        # Viewer setup (render-markdown, monochrome headings, Esc/q) lives in ~/.config/docview/viewer.lua
        *.md) exec setsid -f foot --app-id docview --title "$choice" \
                  nvim --clean -R -M --cmd "luafile $HOME/.config/docview/viewer.lua" "$target" ;;
        *)    setsid -f xdg-open "$target" >/dev/null 2>&1 ;;
    esac
done
