#!/bin/bash
# maintain -> step-by-step upkeep for this Hyprland setup. Asks before each step.
#   1. check    validate Hyprland, fuzzel, shell, Ghostty, Waybar, mako, Neovim and the docs viewer
#   2. backups  find stray *.bak / *.orig / *~ files, archive and remove them
#   3. dotfiles commit config changes to the bare repo (~/.dotfiles), offer new files, push to GitHub
#   4. update   run sysupdate (dnf, flatpak, firmware, snapshots)
#   5. clean    dnf autoremove, old caches, journal, trash
# maintain            run all steps, asking before each
# maintain <step>...  run only the named steps (still confirms anything destructive)
set -uo pipefail

ARCHIVE="$HOME/.local/share/dotfiles-archive"
SCAN_DIRS=(.config/hypr .config/waybar .config/fuzzel .config/mako .config/foot .local/bin)
# Folders whose files belong in the dotfiles repo, relative to $HOME. Tracked files
# are committed when they change; new files in these folders are offered for adding.
# Files to never offer go in ~/.dotfiles/info/exclude.
WATCH=(
    .bashrc.d .config/hypr .config/waybar .config/fuzzel .config/mako .config/foot
    .config/ghostty .config/nvim .config/docview .config/systemd/user
    .local/bin .local/share/applications .local/share/emoji
    .local/share/icons/hicolor/scalable/apps/omawrite.svg
    .claude/skills/setup
)

bold() { printf '\n\e[1;34m==> %s\e[0m\n' "$*"; }
warn() { printf '\e[1;33m!!  %s\e[0m\n' "$*"; }
ok()   { printf '    %s\n' "$*"; }
dot()  { git --git-dir="$HOME/.dotfiles" --work-tree="$HOME" "$@"; }
ask()  { read -rp "    $1 [Y/n] " r; [[ -z "$r" || "$r" == [yY]* ]]; }

# check <name> <cmd…>: run a validator quietly, show its output only on failure
check() {
    local name=$1; shift
    if out=$("$@" 2>&1); then ok "$name: OK"; else warn "$name:"; echo "$out" | sed 's/^/    /'; fi
}

step_check() {
    bold "1. Check configs"
    check Hyprland bash -c 'out=$(Hyprland --verify-config -c "$HOME/.config/hypr/hyprland.lua" 2>&1);
        grep -q "config ok" <<<"$out" || { grep -iE "error|\.lua:" <<<"$out"; exit 1; }'
    check fuzzel fuzzel --check-config
    check "Shell config (~/.bashrc.d)" bash -c 'for f in "$HOME"/.bashrc.d/*; do bash -n "$f" || exit 1; done'
    check Ghostty ghostty +validate-config
    check Waybar python3 -I -c 'import json, re, sys
p = sys.argv[1]; json.loads(re.sub(r"^\s*//.*$", "", open(p).read(), flags=re.M))' \
        "$HOME/.config/waybar/config.jsonc"
    pgrep -x mako >/dev/null && check mako makoctl reload
    # Lua syntax of the nvim config and docs viewer (a headless nvim start doesn't
    # surface LazyVim config errors, so load each file instead)
    check "Neovim + docs viewer (Lua syntax)" nvim -l <(cat <<'LUA'
local bad = 0
for _, dir in ipairs(arg) do
  for _, f in ipairs(vim.fs.find(function(n) return n:match("%.lua$") end,
      { path = dir, type = "file", limit = math.huge })) do
    local ok, err = loadfile(f)
    if not ok then print(err); bad = bad + 1 end
  end
end
os.exit(bad == 0 and 0 or 1)
LUA
) "$HOME/.config/nvim" "$HOME/.config/docview"
    if hyprctl version >/dev/null 2>&1; then
        errs=$(hyprctl configerrors 2>/dev/null | grep -v '^\s*$')
        [[ -z "$errs" ]] && ok "Running session: no errors" || { warn "Running session:"; echo "$errs" | sed 's/^/    /'; }
    fi
    ok "(Ghostty cursor shader: not checked here; it compiles at Ghostty start, see reference.md)"
}

step_backups() {
    bold "2. Stray backup files"
    mapfile -t files < <(cd "$HOME" && find "${SCAN_DIRS[@]}" -maxdepth 2 -type f \
        \( -name '*.bak*' -o -name '.*.bak*' -o -name '*.orig' -o -name '*~' \) 2>/dev/null)
    if (( ${#files[@]} == 0 )); then ok "None found"; return; fi
    printf '    %s\n' "${files[@]}"
    if ask "Archive and remove these ${#files[@]} files?"; then
        mkdir -p "$ARCHIVE"
        tarball="$ARCHIVE/backups-$(date +%F-%H%M).tar.gz"
        (cd "$HOME" && tar czf "$tarball" "${files[@]}" && rm -- "${files[@]}")
        ok "Archived to $tarball"
    fi
}

step_dotfiles() {
    bold "3. Dotfiles snapshot"
    mapfile -t new < <(cd "$HOME" && dot ls-files --others --exclude-standard -- "${WATCH[@]}")
    if (( ${#new[@]} )); then
        echo "    New files not in the repo yet:"
        printf '      %s\n' "${new[@]}"
        if ask "Add them? (no = skip; to never see one again, add it to ~/.dotfiles/info/exclude)"; then
            (cd "$HOME" && dot add -- "${new[@]}")
        fi
    fi
    dot add -u
    if dot diff --cached --quiet; then
        ok "Nothing changed since last snapshot"
    else
        dot -c color.status=always status --short | sed 's/^/    /'
        if ask "Commit these changes?"; then
            msg="Maintenance snapshot $(date +%F)"
            $interactive && read -rp "    Message [$msg]: " m && msg=${m:-$msg}
            dot commit -q -m "$msg" && ok "Committed: $msg"
        else
            dot reset -q
        fi
    fi
    # Push unpushed commits to GitHub (origin)
    dot remote get-url origin >/dev/null 2>&1 || return
    ahead=$(dot rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)
    if (( ahead > 0 )) && ask "Push $ahead commit(s) to GitHub?"; then
        dot push -q && ok "Pushed to $(dot remote get-url origin)"
    fi
}

step_update() {
    bold "4. System update"
    "$HOME/.local/bin/sysupdate"
}

step_clean() {
    bold "5. Clean up"
    if ask "Remove unneeded packages (dnf autoremove)?"; then sudo dnf autoremove; fi
    if [[ -d "$HOME/.cache/wallpick/img" ]]; then
        size=$(du -sh "$HOME/.cache/wallpick/img" | cut -f1)
        if ask "Delete wallpaper previews unused for 30+ days (cache is $size)?"; then
            find "$HOME/.cache/wallpick/img" -type f -atime +30 -delete
            find "$HOME/.cache/wallpick/img" -mindepth 1 -type d -empty -delete
        fi
    fi
    if ask "Trim system journal to the last 4 weeks?"; then sudo journalctl --vacuum-time=4weeks; fi
    trash="$HOME/.local/share/Trash"
    if [[ -n "$(ls -A "$trash/files" 2>/dev/null)" ]] && ask "Empty trash ($(du -sh "$trash" | cut -f1))?"; then
        rm -rf "${trash:?}/files" "${trash:?}/info" && mkdir -p "$trash/files" "$trash/info"
    fi
    find "$ARCHIVE" -name '*.tar.gz' -mtime +90 -print -delete 2>/dev/null | sed 's/^/    removed old archive: /'
    ok "Disk: $(df -h --output=avail,pcent / | tail -1 | awk '{print $1" free ("$2" used)"}')"
}

steps=(check backups dotfiles update clean)
interactive=true
if (( $# )); then steps=("$@"); interactive=false; fi

for s in "${steps[@]}"; do
    if ! declare -F "step_$s" >/dev/null; then warn "Unknown step: $s (use: check backups dotfiles update clean)"; exit 1; fi
    if $interactive && [[ $s != check ]]; then
        read -rp $'\n'"Run step '$s'? [Y/n/q] " r
        [[ "$r" == [qQ]* ]] && exit 0
        [[ -n "$r" && "$r" != [yY]* ]] && continue
    fi
    "step_$s"
done
bold "Done"
